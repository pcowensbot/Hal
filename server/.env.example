# HAL Configuration

# Database
DATABASE_URL="postgresql://hal_user:hal_password_change_me@localhost:5432/hal?connection_limit=10&pool_timeout=20"

# Redis
REDIS_URL="redis://localhost:6379"

# Server
PORT=3000
NODE_ENV=development

# JWT
JWT_SECRET="change_this_to_a_random_string_min_32_chars"
# 24h keeps a reasonable session length without the full 1h access+14d refresh
# split (the split needs client-side auto-refresh handling — Phase 7)
JWT_EXPIRES_IN="24h"

# LLM Provider — "ollama" or "openai" (for vLLM/SGLang/LiteLLM)
#   For Ollama:  model name like "qwen3:8b" (see docs/models.md for sizing)
#   For vLLM:    HF-style path like "Qwen/Qwen2.5-32B-Instruct"
LLM_PROVIDER="ollama"
LLM_BASE_URL="http://localhost:11434"
# Replica pool (docs/scaling.md Stage 1.5): comma-separated backends all
# serving the same model, e.g. one Ollama per GPU. HAL routes each consumer
# (device key / chat user) to a consistent replica — keeps that replica's
# prompt cache hot — and fails over if one goes down. Overrides LLM_BASE_URL.
# LLM_BASE_URLS="http://127.0.0.1:11434,http://127.0.0.1:11435"
# LLM_BACKEND_COOLDOWN_MS=30000  # how long a failed replica sits benched
LLM_DEFAULT_MODEL="qwen3:8b"
LLM_CONTEXT_LENGTH=32768
# LLM_API_KEY=""  # Required for vLLM/LiteLLM with auth enabled
# LLM_FETCH_TIMEOUT_MS=180000  # 3-minute ceiling on backend calls

# Legacy Ollama vars (still work as fallbacks)
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="qwen3:8b"

# CORS — comma-separated allowed origins (leave empty to allow all in dev)
# CORS_ORIGINS="https://hal.example.com,http://localhost:5173"

# Rate Limiting — general API
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=60

# Rate Limiting — /v1 inference proxy (per API key)
V1_RATE_LIMIT_WINDOW_MS=60000
V1_RATE_LIMIT_MAX_REQUESTS=30

# Rate Limiting — GPU broker (per API key)
GPU_RATE_LIMIT_WINDOW_MS=60000
GPU_RATE_LIMIT_MAX_REQUESTS=20

# Public URL shown in the startup banner (optional)
# PUBLIC_URL="https://hal.example.com"

# Docling document processing (optional) — path to the Python interpreter in
# the Docling virtualenv. Defaults to <repo>/.venv/docling/bin/python3
# DOCLING_PYTHON="/path/to/.venv/docling/bin/python3"
