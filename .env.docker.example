# HAL Docker configuration — copy to .env next to docker-compose.yml
# (install.sh generates this for you with random secrets)

# REQUIRED — generate each with: openssl rand -hex 32
JWT_SECRET=change_this_to_a_random_string_min_32_chars
POSTGRES_PASSWORD=change_this_too

# Model HAL uses by default (must be pulled into Ollama — see docs/models.md)
HAL_MODEL=qwen3:8b

# Host port HAL is published on
HAL_PORT=3000

# Context length, set server-wide on Ollama (raise only if your VRAM allows)
OLLAMA_CONTEXT_LENGTH=32768

# Build-time: set to 1 and run `docker compose build` to bake in Docling
# document processing (PDF/DOCX → knowledge base; ~2 GB bigger image)
WITH_DOCLING=0

# Uncomment when serving behind a reverse proxy / domain
# CORS_ORIGINS=https://hal.example.com
# PUBLIC_URL=https://hal.example.com

# Set by install.sh when an NVIDIA GPU is detected — makes plain
# `docker compose` commands include the GPU override automatically
# COMPOSE_FILE=docker-compose.yml:docker-compose.gpu.yml
